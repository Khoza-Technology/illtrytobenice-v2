    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "6 Ounce(s) vanilla pudding, not instant"
      },
      {
        "type": "item",
        "text": "1 Cup(s) brown sugar"
      },
      {
        "type": "item",
        "text": "½ Cup(s) butter, melted"
      },
      {
        "type": "item",
        "text": "2 Tablespoon(s) milk"
      },
      {
        "type": "item",
        "text": "½ Cup(s) walnuts"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Make Alice's Cinnamon Roll dough."
      },
      {
        "type": "step",
        "text": "Cover bottom of 9x13 pan with chopped walnuts."
      },
      {
        "type": "step",
        "text": "Tear up ½ of dough into pan. Cover with sauce. Tear up 2nd part of dough. Sprinkle with cinnamon."
      },
      {
        "type": "step",
        "text": "Cover loosely with saran wrap. Let rise and bake or let rise in refrigerator and bake within 4-5 days."
      },
      {
        "type": "step",
        "text": "Preheat oven to 350 and bake 30-35 minutes."
      },
      {
        "type": "step",
        "text": "Turn onto platter and serve immediately."
      }
    ],
