  "recipe": {
    "id": "molasses-breakfast-bread",
    "slug": "molasses-breakfast-bread",
    "title": "Molasses Breakfast Bread",
    "summary": null,
    "contributor": "amy",
    "categories": [
      "bread"
    ],
    "cuisine": "American",
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "¾ Cup(s) molasses"
      },
      {
        "type": "item",
        "text": "¾ Cup(s) boiling water"
      },
      {
        "type": "item",
        "text": "¼ Cup(s) butter, room temperature"
      },
      {
        "type": "item",
        "text": "⅓ Cup(s) shortening"
      },
      {
        "type": "item",
        "text": "½ Cup(s) brown sugar"
      },
      {
        "type": "item",
        "text": "¼ Cup(s) sugar"
      },
      {
        "type": "item",
        "text": "2 eggs"
      },
      {
        "type": "item",
        "text": "2½ Cup(s) Bob's Red Mill gluten-free baking flour"
      },
      {
        "type": "item",
        "text": "2 Teaspoon(s) ginger"
      },
      {
        "type": "item",
        "text": "1 Teaspoon(s) cinnamon"
      },
      {
        "type": "item",
        "text": "1 Teaspoon(s) baking powder"
      },
      {
        "type": "item",
        "text": "½ Teaspoon(s) baking soda"
      },
      {
        "type": "item",
        "text": "½ Teaspoon(s) salt"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "In a small bowl, combine molasses and boiling water; set aside."
      },
      {
        "type": "step",
        "text": "In a large bowl, cream butter, shortening and sugars until light and fluffy. Add eggs. Gradually add molasses mixture."
      },
      {
        "type": "step",
        "text": "Combine flour, ginger, cinnamon, baking powder, baking soda and salt; gradually add to creamed mixture."
      },
      {
        "type": "step",
        "text": "Transfer to three 5.75x3x2-in loaf pans coated with spray. Bake at 325 for 30 minutes or until a toothpick inserted near the center comes out clean."
      },
      {
        "type": "step",
        "text": "Cool for 10 minutes before removing from pans to wire racks."
      }
    ],
    "notes": null,
