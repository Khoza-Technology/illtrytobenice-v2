    "title": "Spicy Almonds",
    "summary": null,
    "contributor": "amy",
    "categories": [
      "sides"
    ],
    "cuisine": "American",
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "6 cup whole natural almonds"
      },
      {
        "type": "item",
        "text": "1 cup extra-virgin olive oil"
      },
      {
        "type": "item",
        "text": "4 tablespoons soy sauce"
      },
      {
        "type": "item",
        "text": "3 tablespoons maple syrup"
      },
      {
        "type": "item",
        "text": "1 tablespoon cumin"
      },
      {
        "type": "item",
        "text": "1 tablespoon garlic powder"
      },
      {
        "type": "item",
        "text": "1 tablespoon coarse sea salt"
      },
      {
        "type": "item",
        "text": "1½ teaspoon cayenne"
      },
      {
        "type": "item",
        "text": "1½ teaspoon paprika"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Preheat the oven to 350°F. Toss all of the ingredients together in a bowl, then spread the almonds in a single layer on a baking sheet lined with parchment paper and drizzle with any remaining sauce."
      },
      {
        "type": "step",
        "text": "Bake for 20 minutes, turning once halfway through. Cool completely, then roughly chop."
      }
    ],
