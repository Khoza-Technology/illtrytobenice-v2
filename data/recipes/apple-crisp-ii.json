    "ingredients": [
      {
        "type": "item",
        "text": "10 cups all-purpose apples, peeled, cored and sliced"
      },
      {
        "type": "item",
        "text": "1 cup white sugar"
      },
      {
        "type": "item",
        "text": "1 tablespoon all-purpose flour"
      },
      {
        "type": "item",
        "text": "1 teaspoon ground cinnamon"
      },
      {
        "type": "item",
        "text": "½ cup water"
      },
      {
        "type": "item",
        "text": "1 cup quick-cooking oats"
      },
      {
        "type": "item",
        "text": "1 cup all-purpose flour"
      },
      {
        "type": "item",
        "text": "1 cup packed brown sugar"
      },
      {
        "type": "item",
        "text": "¼ teaspoon baking powder"
      },
      {
        "type": "item",
        "text": "¼ teaspoon baking soda"
      },
      {
        "type": "item",
        "text": "½ cup butter, melted"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Preheat oven to 350 degrees F (175 degree C)."
      },
      {
        "type": "step",
        "text": "Place the sliced apples in a 9x13 inch pan. Mix the white sugar, 1 tablespoon flour and ground cinnamon together, and sprinkle over apples. Pour water evenly over all."
      },
      {
        "type": "step",
        "text": "Combine the oats, 1 cup flour, brown sugar, baking powder, baking soda and melted butter together. Crumble evenly over the apple mixture."
      },
      {
        "type": "step",
        "text": "Bake at 350 degrees F (175 degrees C) for about 45 minutes."
      }
    ],
