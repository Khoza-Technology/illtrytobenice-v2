  "recipe": {
    "id": "brined-pork-tenderloin",
    "slug": "brined-pork-tenderloin",
    "title": "Brined Pork Tenderloin",
    "summary": null,
    "contributor": "amy",
    "categories": [
      "dinner"
    ],
    "cuisine": null,
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "½ cup salt"
      },
      {
        "type": "item",
        "text": "1 capful whole peppercorns (3 tablespoons)"
      },
      {
        "type": "item",
        "text": "¼ cup thyme"
      },
      {
        "type": "item",
        "text": "¼ cup rosemary"
      },
      {
        "type": "item",
        "text": "12 bay leaves"
      },
      {
        "type": "item",
        "text": "½ cup honey"
      },
      {
        "type": "item",
        "text": "1 pork tenderloin"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Add the dry ingredients and honey into a medium pot and fill pot half way full with water."
      },
      {
        "type": "step",
        "text": "Stir until salt and honey are dissolved."
      },
      {
        "type": "step",
        "text": "Place pork tenderloin into pot and brine for 2 hours."
      },
      {
        "type": "step",
        "text": "Preheat oven to 425 degrees Fahrenheit."
      },
      {
        "type": "step",
        "text": "Heat vegetable oil in an oven-proof skillet over high heat. Cook pork, turning to brown each side, about 10 minutes total."
      },
      {
        "type": "step",
        "text": "Transfer skillet to oven and roast until pork is browned and has reached 135 degrees Fahrenheit, about 20 minutes."
      },
      {
        "type": "step",
        "text": "Let pork rest for ten minutes."
      }
    ],
    "notes": null,
