        "type": "step",
        "text": "Freeze."
      },
      {
        "type": "step",
        "text": "When ready to bake, preheat oven to 425. Place frozen pie on a rimmed baking sheet."
      },
      {
        "type": "step",
        "text": "Bake uncovered for 15 minutes. Reduce oven to 375 and bake for 1 hour more."
      }
