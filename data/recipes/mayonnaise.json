    "id": "mayonnaise",
    "slug": "mayonnaise",
    "title": "Mayonnaise",
    "summary": null,
    "contributor": "amy",
    "categories": [],
    "cuisine": null,
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "1 large egg yolk"
      },
      {
        "type": "item",
        "text": "1 teaspoon lemon juice"
      },
      {
        "type": "item",
        "text": "1 teaspoon white vinegar"
      },
      {
        "type": "item",
        "text": "½ teaspoon sea salt"
      },
      {
        "type": "item",
        "text": "¼ teaspoon Dijon mustard"
      },
      {
        "type": "item",
        "text": "¾ cup olive oil"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Place the egg, lemon juice, white vinegar, sea salt, and Dijon mustard in a small blender or food processor and blend on low until combined."
      },
      {
        "type": "step",
        "text": "With the blender on medium-low, add the oil 1 drop at a time until the mixture resembles mayonnaise. Begin adding the oil in a slow stream with the blender still running, until all the oil has been incorporated."
      },
      {
        "type": "step",
        "text": "Cover and chill."
      }
    ],
    "notes": null,
