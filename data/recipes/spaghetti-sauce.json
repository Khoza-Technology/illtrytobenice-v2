    "ingredients": [
      {
        "type": "item",
        "text": "1 Pound(s) beef stew meat"
      },
      {
        "type": "item",
        "text": "1 Pound(s) ground beef"
      },
      {
        "type": "item",
        "text": "2 medium onions, chopped"
      },
      {
        "type": "item",
        "text": "2 red pepper, seeded and chopped"
      },
      {
        "type": "item",
        "text": "1 Tablespoon(s) garlic, minced"
      },
      {
        "type": "item",
        "text": "2 Tablespoon(s) sugar"
      },
      {
        "type": "item",
        "text": "1 Tablespoon(s) salt"
      },
      {
        "type": "item",
        "text": "2 Teaspoon(s) leaf basil"
      },
      {
        "type": "item",
        "text": "⅛ Teaspoon(s) crushed red pepper"
      },
      {
        "type": "item",
        "text": "32 Ounce(s) italian-style tomatoes (2 16 oz cans)"
      },
      {
        "type": "item",
        "text": "8 Ounce(s) tomato sauce (1 can)"
      },
      {
        "type": "item",
        "text": "6 Ounce(s) tomato paste (1 can)"
      },
      {
        "type": "item",
        "text": "2 cooked sausage, cut into pieces"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Brown stew meat and ground beef in large stockpot or dutch oven."
      },
      {
        "type": "step",
        "text": "Add rest of ingredients and cook over high heat until boiling."
      },
      {
        "type": "step",
        "text": "Turn heat down to low and let cook for 5 to 8 hours stirring once every hour. Cover pot with a lid once the sauce is the thickness you want. If you don't want to cook on the stovetop, heat oven to 300 and place stockpot or dutch oven in the oven with the lid on and cook for 6 hours."
      },
      {
        "type": "step",
        "text": "Test taste sauce and add more salt/pepper."
      }
    ],
