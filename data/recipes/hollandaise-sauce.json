    "ingredients": [
      {
        "type": "item",
        "text": "2 egg yolks"
      },
      {
        "type": "item",
        "text": "¼ lemon, juiced, or to taste"
      },
      {
        "type": "item",
        "text": "1 pinch salt"
      },
      {
        "type": "item",
        "text": "1 pinch cayenne pepper"
      },
      {
        "type": "item",
        "text": "¼ cup salted butter, melted"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Beat egg yolks, lemon juice, salt, and cayenne pepper together in a microwave-safe bowl until smooth. Slowly stream melted butter into the egg yolk mixture while whisking to incorporate."
      },
      {
        "type": "step",
        "text": "Heat in microwave for 15 to 20 seconds; whisk."
      }
    ],
