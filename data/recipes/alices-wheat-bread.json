  "schemaVersion": 1,
  "recipe": {
    "id": "alices-wheat-bread",
    "slug": "alices-wheat-bread",
    "title": "Alice's Wheat Bread",
    "summary": null,
    "contributor": "genevieve",
    "categories": [
      "bread"
    ],
    "cuisine": null,
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "1 Cup(s) wheat germ"
      },
      {
        "type": "item",
        "text": "1 Cup(s) wheat bran"
      },
      {
        "type": "item",
        "text": "1 Cup(s) 7 or 10 grain cereal"
      },
      {
        "type": "item",
        "text": "6 Tablespoon(s) sugar"
      },
      {
        "type": "item",
        "text": "6 Tablespoon(s) unsulfured molasses"
      },
      {
        "type": "item",
        "text": "6 Tablespoon(s) honey"
      },
      {
        "type": "item",
        "text": "3 Tablespoon(s) salt"
      },
      {
        "type": "item",
        "text": "1 Cup(s) olive oil"
      },
      {
        "type": "item",
        "text": "4 Tablespoon(s) active dry yeast"
      },
      {
        "type": "item",
        "text": "8 Cup(s) water"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Combine yeast and warm water in a large bowl."
      },
      {
        "type": "step",
        "text": "Add wheat germ, bran, cereal, sugar, molasses, honey, salt, and oil."
      },
      {
        "type": "step",
        "text": "Add 2 cups of whole wheat flour and 1 cup of white flour at a time and mix. Keep adding flour in this ratio until the dough no longer sticks to your hands and when you poke with your finger, the dough bounces back."
      },
      {
        "type": "step",
        "text": "Knead until nice and smooth."
      },
      {
        "type": "step",
        "text": "Place dough in oiled bowl and turn the dough over. Cover with cloth and let rise until doubled (1½ hours)."
      },
      {
        "type": "step",
        "text": "Divide into 6 portions. Shape each into large rectangle. On the longer side, roll up. Fold ends under and place seam side down in greased loaf pans."
      },
      {
        "type": "step",
        "text": "Cover with cloth and let rise until doubled (1½ hours)."
      },
      {
        "type": "step",
        "text": "Preheat oven to 350. Bake for 30 minutes, rotating halfway."
      },
      {
        "type": "step",
        "text": "Let cool and wrap in bread bags. Freeze. Reheat at 300 for 20-25 minutes in foil if necessary."
      }
    ],
    "notes": null,
