      },
      "total": {
        "iso": "PT40M",
        "minutes": 40,
        "label": "40 mins"
      }
    },
    "servings": {
      "label": "6 to 8",
      "count": 6
    },
    "ingredients": [
      {
        "type": "item",
        "text": "1 pork tenderloin"
      },
      {
        "type": "item",
        "text": "1 red onion, thinly sliced"
      },
      {
        "type": "item",
        "text": "6 sprigs rosemary, finely chopped"
      },
      {
        "type": "item",
        "text": "2 tbsp dried oregano"
      },
      {
        "type": "item",
        "text": "4 cloves garlic, thinly sliced"
      },
      {
        "type": "item",
        "text": "4 tbsp white wine vinegar"
      },
      {
        "type": "item",
        "text": "5 tbsp olive oil"
      },
      {
        "type": "item",
        "text": "½ tsp salt"
      },
      {
        "type": "item",
        "text": "¼ tsp pepper"
      },
      {
        "type": "item",
        "text": "2 tsp honey"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Remove white membrane covering the pork."
      },
      {
        "type": "step",
        "text": "Cut meat on the diagonal into .5 cm slices. Place slices in a medium bowl."
      },
      {
        "type": "step",
        "text": "Add rest of ingredients to the bowl and mix well."
      },
      {
        "type": "step",
        "text": "Cover with plastic wrap, refrigerate 6 hours or overnight."
      },
      {
        "type": "step",
        "text": "Heat pan over high heat. Add 2 tbsp olive oil and just enough meat to cover the bottom of the pan. Brown on both sides."
      },
      {
        "type": "step",
        "text": "Add 1 tbsp white wine vinegar and stir. Once the vinegar has evaporated, transfer meat to a bowl."
      },
      {
        "type": "step",
        "text": "Continue to cook the rest of the meat, adding 2 tbsp oil at the start and 1 tbsp vinegar at the end of each batch."
      }
    ],
    "notes": null,
