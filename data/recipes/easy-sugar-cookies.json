    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "2¾ cups all-purpose flour"
      },
      {
        "type": "item",
        "text": "1 teaspoon baking soda"
      },
      {
        "type": "item",
        "text": "½ teaspoon baking powder"
      },
      {
        "type": "item",
        "text": "1 cup butter, softened"
      },
      {
        "type": "item",
        "text": "1½ cups white sugar"
      },
      {
        "type": "item",
        "text": "1 egg"
      },
      {
        "type": "item",
        "text": "1 teaspoon vanilla extract"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Preheat oven to 375 degrees F (190 degrees C). In a small bowl, stir together flour, baking soda, and baking powder. Set aside."
      },
      {
        "type": "step",
        "text": "In a large bowl, cream together the butter and sugar until smooth. Beat in egg and vanilla. Gradually blend in the dry ingredients. Roll rounded teaspoonfuls of dough into balls, and place onto ungreased cookie sheets."
      },
      {
        "type": "step",
        "text": "Bake 8 to 10 minutes in the preheated oven, or until golden. Let stand on cookie sheet two minutes before removing to cool on wire racks."
      }
    ],
