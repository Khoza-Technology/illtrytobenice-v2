    "ingredients": [
      {
        "type": "item",
        "text": "6 oz can tomato paste"
      },
      {
        "type": "item",
        "text": "3 cups water"
      },
      {
        "type": "item",
        "text": "3 tablespoons white vinegar"
      },
      {
        "type": "item",
        "text": "½ cup pickled jalapeno slices, drained"
      },
      {
        "type": "item",
        "text": "1½ teaspoons chili powder"
      },
      {
        "type": "item",
        "text": "1½ teaspoons ground ancho chili powder"
      },
      {
        "type": "item",
        "text": "1 tablespoon dehydrated minced onions"
      },
      {
        "type": "item",
        "text": "2 teaspoons salt"
      },
      {
        "type": "item",
        "text": "2 teaspoons cornstarch"
      },
      {
        "type": "item",
        "text": "1 teaspoon cayenne pepper"
      },
      {
        "type": "item",
        "text": "1 teaspoon sugar"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Combine all ingredients in a blender, and blend until smooth. Transfer to a saucepan, and bring to a simmer over medium heat. Simmer, stirring occasionally. Transfer to a container and refrigerate overnight before using."
      }
    ],
