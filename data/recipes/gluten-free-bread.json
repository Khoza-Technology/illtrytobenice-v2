  "recipe": {
    "id": "gluten-free-bread",
    "slug": "gluten-free-bread",
    "title": "Gluten-Free Bread",
    "summary": null,
    "contributor": "amy",
    "categories": [
      "bread"
    ],
    "cuisine": "American",
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "5⅓ Cup(s) water"
      },
      {
        "type": "item",
        "text": "1 Cup(s) olive oil"
      },
      {
        "type": "item",
        "text": "1 Cup(s) honey"
      },
      {
        "type": "item",
        "text": "12 egg"
      },
      {
        "type": "item",
        "text": "2 Tablespoon(s) salt"
      },
      {
        "type": "item",
        "text": "4 Cup(s) Sorghum flour"
      },
      {
        "type": "item",
        "text": "4 Cup(s) almond flour"
      },
      {
        "type": "item",
        "text": "4 Cup(s) potato starch"
      },
      {
        "type": "item",
        "text": "4 Tablespoon(s) xanthan gum"
      },
      {
        "type": "item",
        "text": "4 Tablespoon(s) active dry yeast"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Grease 4 bread loaf pans."
      },
      {
        "type": "step",
        "text": "Using a whisk, mix all dry ingredients together in a large bowl. In a separate bowl whisk eggs until yolks are broken up. Add warm water, oil, honey, eggs to the dry mixture. Stir well. The consistency of the bread should be like banana bread. It should be very wet and gloppy."
      },
      {
        "type": "step",
        "text": "Divide between 4 loaf pans. Cover and let rise until it reaches the top of the pan."
      },
      {
        "type": "step",
        "text": "Preheat oven to 350."
      },
      {
        "type": "step",
        "text": "Bake for 30 minutes. Take out of pans and let cool on rack."
      },
      {
        "type": "step",
        "text": "Once completely cooled, bread can be placed in bread bags and frozen."
      }
    ],
    "notes": null,
