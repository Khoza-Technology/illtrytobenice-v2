      {
        "type": "item",
        "text": "1 (15 ounce) can black beans, rinsed and drained"
      },
      {
        "type": "item",
        "text": "2 (15 ounce) cans whole kernel corn, drained"
      },
      {
        "type": "item",
        "text": "8 green onions, chopped"
      },
      {
        "type": "item",
        "text": "2 jalapeno peppers, seeded and minced"
      },
      {
        "type": "item",
        "text": "1 green bell pepper, chopped"
      },
      {
        "type": "item",
        "text": "1 avocado - peeled, pitted, and diced"
      },
      {
        "type": "item",
        "text": "1 (4 ounce) jar pimentos"
      },
      {
        "type": "item",
        "text": "3 tomatoes, seeded and chopped"
      },
      {
        "type": "item",
        "text": "1 cup chopped fresh cilantro"
      },
      {
        "type": "item",
        "text": "1 lime, juiced"
      },
      {
        "type": "item",
        "text": "½ cup Italian salad dressing"
      },
      {
        "type": "item",
        "text": "½ teaspoon garlic salt"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "In a large bowl, combine the black beans, corn, green onions, jalapeno peppers, bell pepper, avocado, pimentos, tomatoes, cilantro, lime juice, and Italian dressing. Season with garlic salt. Toss, and chill until serving."
      }
