    "categories": [
      "dessert"
    ],
    "cuisine": "American",
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "1 yellow cake mix"
      },
      {
        "type": "item",
        "text": "½ Cup(s) light brown sugar"
      },
      {
        "type": "item",
        "text": "8 Tablespoon(s) butter, melted"
      },
      {
        "type": "item",
        "text": "2 eggs"
      },
      {
        "type": "item",
        "text": "1 Cup(s) chopped candy bar, snickers, butterfinger, whatever"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Preheat oven to 350."
      },
      {
        "type": "step",
        "text": "Mix cake mix, brown sugar, butter, and eggs at medium speed for 2 minutes or so until light and fluffy."
      },
      {
        "type": "step",
        "text": "Spoon in candy bar."
      },
      {
        "type": "step",
        "text": "Pour in greased 9x13 pan and cook for 40 to 45 minutes. Let cool. Cut and serve."
      }
    ],
    "notes": null,
