        "type": "item",
        "text": "1 apple, diced into pieces"
      },
      {
        "type": "item",
        "text": "½ Can(s) white grape juice concentrate"
      },
      {
        "type": "item",
        "text": "⅓ Cup(s) walnuts, coarsely chopped and toasted"
      },
      {
        "type": "item",
        "text": "1 Cup(s) oatmeal"
      },
      {
        "type": "item",
        "text": "2 Cup(s) milk"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Put apples and white grape juice in a small saucepan and cook over medium heat until apples are tender, about 20 minutes."
      },
