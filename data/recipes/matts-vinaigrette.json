    "title": "Matt's Vinaigrette",
    "summary": null,
    "contributor": "amy",
    "categories": [],
    "cuisine": null,
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "¼ Cup(s) balsamic vinegar"
      },
      {
        "type": "item",
        "text": "1½ Tablespoon(s) red wine vinegar"
      },
      {
        "type": "item",
        "text": "2 Tablespoon(s) brown sugar"
      },
      {
        "type": "item",
        "text": "1½ Tablespoon(s) dijon mustard"
      },
      {
        "type": "item",
        "text": "1 Tablespoon(s) kosher salt"
      },
      {
        "type": "item",
        "text": "½ Tablespoon(s) pepper"
      },
      {
        "type": "item",
        "text": "1½ Cup(s) extra virgin olive oil"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Combine all the ingredients and pour into container (20 oz Rubbermaid water bottle w/ lid works great) and shake.**"
      },
      {
        "type": "step",
        "text": "** For extra strength, double the balsamic, red wine vinegar, and dijon mustard. This is the Simonsen preference, however we generally serve guests as above."
      }
    ],
    "notes": null,
