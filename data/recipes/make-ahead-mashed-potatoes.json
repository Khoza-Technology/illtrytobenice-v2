  "recipe": {
    "id": "make-ahead-mashed-potatoes",
    "slug": "make-ahead-mashed-potatoes",
    "title": "Make-Ahead Mashed Potatoes",
    "summary": null,
    "contributor": "amy",
    "categories": [
      "sides"
    ],
    "cuisine": "American",
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "5 Pound(s) potatoes, cubed"
      },
      {
        "type": "item",
        "text": "6 Ounce(s) cream cheese"
      },
      {
        "type": "item",
        "text": "8 Ounce(s) sour cream, light"
      },
      {
        "type": "item",
        "text": "½ Cup(s) milk"
      },
      {
        "type": "item",
        "text": "2 Teaspoon(s) onion salt"
      },
      {
        "type": "item",
        "text": "1 salt and pepper to taste"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Preheat oven to 325 degrees F."
      },
      {
        "type": "step",
        "text": "Place potatoes in a large pot of lightly salted water. Bring to a boil and cook until tender, about 15 minutes. Drain and mash."
      },
      {
        "type": "step",
        "text": "In a large bowl mix mashed potatoes, cream cheese, sour cream, milk, onion salt and pepper. Transfer to a greased large casserole dish."
      },
      {
        "type": "step",
        "text": "Cover and bake for 50 minutes in"
      },
      {
        "type": "step",
        "text": "the preheated oven."
      },
      {
        "type": "step",
        "text": "Option: This dish can be made ahead of time (refrigerate if it is made early in the day. Remove from refrigerator for about 30 minutes and then bake as directed above."
      }
    ],
    "notes": null,
