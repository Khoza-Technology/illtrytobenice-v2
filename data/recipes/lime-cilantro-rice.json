    "ingredients": [
      {
        "type": "item",
        "text": "2 cups water"
      },
      {
        "type": "item",
        "text": "1 tablespoon butter"
      },
      {
        "type": "item",
        "text": "1 cup long-grain white rice"
      },
      {
        "type": "item",
        "text": "1 teaspoon lime zest"
      },
      {
        "type": "item",
        "text": "2 tablespoons fresh lime juice"
      },
      {
        "type": "item",
        "text": "1/2 cup chopped cilantro"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Bring the water to a boil; stir the butter and rice into the water. Cover, reduce heat to low, and simmer until the rice is tender, about 20 minutes."
      },
      {
        "type": "step",
        "text": "Stir the lime zest, lime juice, and cilantro into the cooked rice just before serving."
      }
    ],
