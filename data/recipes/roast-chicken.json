    "categories": [
      "dinner"
    ],
    "cuisine": "American",
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "1 cup salt"
      },
      {
        "type": "item",
        "text": "1 cap full whole peppercorns (3 tablespoons)"
      },
      {
        "type": "item",
        "text": "¼ cup thyme"
      },
      {
        "type": "item",
        "text": "¼ cup rosemary"
      },
      {
        "type": "item",
        "text": "12 bay leaves"
      },
      {
        "type": "item",
        "text": "½ cup honey"
      },
      {
        "type": "item",
        "text": "1 whole chicken"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Add the dry ingredients and honey into a large pot."
      },
      {
        "type": "step",
        "text": "Add water half way to the top of the pot and stir until the honey and salt dissolve."
      },
      {
        "type": "step",
        "text": "Clean the chicken. Put the chicken into the water breast side down. Add water to an inch or two from the top of the pot. Cover with lid and put into refrigerator. Let brine for at least six hours."
      },
      {
        "type": "step",
        "text": "Preheat the oven to 475 degrees Fahrenheit."
      },
      {
        "type": "step",
        "text": "Rinse the brine out of the pot and dry the pot. Rinse out and dry the chicken."
      },
      {
        "type": "step",
        "text": "Truss the chicken."
      },
      {
        "type": "step",
        "text": "Place the chicken in oven on the middle rack and cook for one hour."
      }
    ],
    "notes": null,
