    "ingredients": [
      {
        "type": "item",
        "text": "2 Cup(s) flour"
      },
      {
        "type": "item",
        "text": "¼ Cup(s) light brown sugar"
      },
      {
        "type": "item",
        "text": "1 Teaspoon(s) baking soda"
      },
      {
        "type": "item",
        "text": "1½ Teaspoon(s) baking powder"
      },
      {
        "type": "item",
        "text": "½ Teaspoon(s) cinnamon"
      },
      {
        "type": "item",
        "text": "½ Teaspoon(s) salt"
      },
      {
        "type": "item",
        "text": "3 eggs, separated"
      },
      {
        "type": "item",
        "text": "2 Cup(s) buttermilk"
      },
      {
        "type": "item",
        "text": "½ Cup(s) butter, melted"
      },
      {
        "type": "item",
        "text": "1 Teaspoon(s) vanilla"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Beat the egg whites until stiff but not dry. Combine dry ingredients in a large bowl. Whisk together egg yolks, buttermilk, butter, and vanilla in a medium bowl. Pour buttermilk mixture into dry ingredients and mix well. Fold whites into the batter. Bake in waffle iron."
      }
