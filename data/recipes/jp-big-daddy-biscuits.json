      }
    },
    "servings": {
      "label": "6",
      "count": 6
    },
    "ingredients": [
      {
        "type": "item",
        "text": "2 cups all-purpose flour"
      },
      {
        "type": "item",
        "text": "1 tablespoon baking powder"
      },
      {
        "type": "item",
        "text": "1 teaspoon salt"
      },
      {
        "type": "item",
        "text": "1 tablespoon white sugar"
      },
      {
        "type": "item",
        "text": "1/3 cup shortening"
      },
      {
        "type": "item",
        "text": "1 cup milk"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Preheat oven to 425 degrees F (220 degrees C)."
      },
      {
        "type": "step",
        "text": "In a large bowl, whisk together the flour, baking powder, salt, and sugar. Cut in the shortening until the mixture resembles coarse meal. Gradually stir in milk until dough pulls away from the side of the bowl."
      },
      {
        "type": "step",
        "text": "Turn out onto a floured surface, and knead 15 to 20 times. Pat or roll dough out to 1 inch thick. Cut biscuits with a large cutter or juice glass dipped in flour. Repeat until all dough is used. Brush off the excess flour, and place biscuits onto an ungreased baking sheet."
      },
      {
        "type": "step",
        "text": "Bake for 13 to 15 minutes in the preheated oven, or until edges begin to brown."
      }
    ],
    "notes": null,
