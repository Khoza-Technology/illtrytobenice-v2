        "type": "item",
        "text": "9 Golden Delicious apples"
      },
      {
        "type": "item",
        "text": "¼ Teaspoon(s) salt"
      },
      {
        "type": "item",
        "text": "⅔ Cup(s) sugar"
      },
      {
        "type": "item",
        "text": "5 Teaspoon(s) lemon juice"
      },
      {
