      },
      {
        "type": "item",
        "text": "4 Tablespoon(s) corn starch"
      },
      {
        "type": "item",
        "text": "½ Tablespoon(s) ground cinnamon"
      },
      {
        "type": "item",
        "text": "¼ Tablespoon(s) pure vanilla extract"
      },
      {
        "type": "item",
        "text": "¼ Tablespoon(s) ground nutmeg"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Peel and core apples."
      },
      {
        "type": "step",
        "text": "In a large bowl, add salt, sugar, lemon juice, cinnamon, nutmeg, and apples."
      },
      {
        "type": "step",
        "text": "Melt butter in a large saute pan over high heat. Add apple mixture and cook until soft."
      },
      {
        "type": "step",
        "text": "Add corn starch and cook 1 minute more. Add vanilla. Stir.."
