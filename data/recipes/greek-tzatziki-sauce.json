      "dinner"
    ],
    "cuisine": "Greek",
    "times": {
      "prep": {
        "iso": "PT20M",
        "minutes": 20,
        "label": "20 mins"
      },
      "total": {
        "iso": "PT20M",
        "minutes": 20,
        "label": "20 mins"
      }
    },
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "300 g Greek plain yogurt"
      },
      {
        "type": "item",
        "text": "1 cucumber"
      },
      {
        "type": "item",
        "text": "⅓ garlic clove"
      },
      {
        "type": "item",
        "text": "1 tbsp white wine vinegar for the cucumber"
      },
      {
        "type": "item",
        "text": "2 tbsp white wine vinegar"
      },
      {
        "type": "item",
        "text": "3 tbsp olive oil"
      },
      {
        "type": "item",
        "text": "salt"
      },
      {
        "type": "item",
        "text": "pepper"
      },
      {
        "type": "item",
        "text": "2 to 3 tbsp dill, finely chopped"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Peel the cucumber and discard skin. Grate cucumber using the large blades on a cheese grater."
      },
      {
        "type": "step",
        "text": "Put shavings in a bowl."
      },
      {
        "type": "step",
        "text": "Add a pinch of salt and 1 tbsp white wine vinegar. Mix and set aside."
      },
      {
        "type": "step",
        "text": "In a blender, combine garlic and 3 tbsp olive oil. Pulverize until smooth."
      },
      {
        "type": "step",
        "text": "Add yogurt, garlic oil mixture, and 2 tbsp white wine vinegar in a bowl. Combine."
      },
      {
        "type": "step",
        "text": "Lay a cotton towel over a bowl and add cucumber to the center of it. Fold and twist the towel so that you squeeze out all the water. Discard the liquid."
      },
      {
        "type": "step",
        "text": "Add the cucumber to the yogurt mixture."
      },
      {
        "type": "step",
        "text": "Salt and pepper to taste."
      },
      {
        "type": "step",
        "text": "Add the dill."
      },
      {
        "type": "step",
        "text": "Refrigerate until needed."
      }
    ],
    "notes": null,
