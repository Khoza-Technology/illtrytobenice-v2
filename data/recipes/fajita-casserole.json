    "ingredients": [
      {
        "type": "item",
        "text": "4 chicken breast"
      },
      {
        "type": "item",
        "text": "1 diced onion"
      },
      {
        "type": "item",
        "text": "1 Tablespoon(s) minced garlic"
      },
      {
        "type": "item",
        "text": "1 red pepper, seeded and chopped"
      },
      {
        "type": "item",
        "text": "2 Tablespoon(s) olive oil"
      },
      {
        "type": "item",
        "text": "1 lawrys fajita seasoning"
      },
      {
        "type": "item",
        "text": "1 Can(s) pace salsa"
      },
      {
        "type": "item",
        "text": "1 Can(s) Olives sliced"
      },
      {
        "type": "item",
        "text": "1 Can(s) frozen corn"
      },
      {
        "type": "item",
        "text": "3 Cup(s) grated cheddar cheese"
      },
      {
        "type": "item",
        "text": "1 Package(s) penne pasta, cooked al dente"
      },
      {
        "type": "item",
        "text": "1 Can(s) black beans"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Prepare pasta al dente."
      },
      {
        "type": "step",
        "text": "Slice chicken. Add 2 tablespoons oil to a large skillet. When hot, add chicken, onion, pepper, garlic. Season with salt and pepper."
      },
      {
        "type": "step",
        "text": "Add one fajita spice packet (Lawrys), along with water according to pkg instructions."
      },
      {
        "type": "step",
        "text": "Add one jar pace salsa."
      },
      {
        "type": "step",
        "text": "Mix all together."
      },
      {
        "type": "step",
        "text": "Add all to one prepared pkg of pasta."
      },
      {
        "type": "step",
        "text": "Add one can whole olives- sliced"
      },
      {
        "type": "step",
        "text": "Add one can blk beans"
      },
      {
        "type": "step",
        "text": "One can corn or 2 cups frozen corn"
      },
      {
        "type": "step",
        "text": "cups grated sharp cheddar"
      },
      {
        "type": "step",
        "text": "Stir all til combined."
      },
      {
        "type": "step",
        "text": "Spread into casserole."
      },
      {
        "type": "step",
        "text": "Bake at 375 until heated through and crunchy around the edges."
      }
    ],
