    "ingredients": [
      {
        "type": "item",
        "text": "1 cup butter, melted"
      },
      {
        "type": "item",
        "text": "2 cups graham cracker crumbs"
      },
      {
        "type": "item",
        "text": "2 cups confectioners' sugar"
      },
      {
        "type": "item",
        "text": "1 cup peanut butter"
      },
      {
        "type": "item",
        "text": "1½ cups semisweet chocolate chips"
      },
      {
        "type": "item",
        "text": "4 tbsp peanut butter"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "In a medium bowl, mix together the butter, graham cracker crumbs, confectioners' sugar, and 1 cup peanut butter until well blended. Press evenly into the bottom of an ungreased 9x13 pan."
      },
      {
        "type": "step",
        "text": "In a metal bowl over simmering water, or in the microwave, melt the chocolate chips with the peanut butter, stirring occasionally until smooth. Spread over the prepared crust. Refrigerate for at least one hour before cutting into square."
      }
    ],
