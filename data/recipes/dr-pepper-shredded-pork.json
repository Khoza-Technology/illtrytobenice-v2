    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "1 Pork Shoulder"
      },
      {
        "type": "item",
        "text": "1 yellow onion"
      },
      {
        "type": "item",
        "text": "11 Ounce(s) Chipotle Peppers in Adobo Sauce"
      },
      {
        "type": "item",
        "text": "2 Can(s) Dr. Pepper"
      },
      {
        "type": "item",
        "text": "2 Tablespoon(s) brown sugar"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Preheat oven to 300 degrees."
      },
      {
        "type": "step",
        "text": "Generously salt and pepper pork and set in dutch oven. Cut onion into wedges and place in pan."
      },
      {
        "type": "step",
        "text": "Pour in can of chipotle peppers over pork. Pour in both cans of Dr. Pepper. Add brown sugar and stir in."
      },
      {
        "type": "step",
        "text": "Cook 5 to 6 hours."
      },
      {
        "type": "step",
        "text": "Shred meat and strain fat off liquid. Serve over tortillas with tomatoes, cilantro, shredded cheese."
      }
    ],
    "notes": null,
