{
  "schemaVersion": 1,
  "recipe": {
    "id": "cornbread",
    "slug": "cornbread",
    "title": "Cornbread",
    "summary": null,
    "contributor": "amy",
    "categories": [
      "sides"
    ],
    "cuisine": "American",
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "1½ Cup(s) flour"
      },
      {
        "type": "item",
        "text": "⅔ Cup(s) sugar"
      },
      {
        "type": "item",
        "text": "½ Cup(s) yellow corn meal"
      },
      {
        "type": "item",
        "text": "1 Tablespoon(s) baking powder"
      },
      {
        "type": "item",
        "text": "½ Teaspoon(s) salt"
      },
      {
        "type": "item",
        "text": "1¼ Cup(s) milk"
      },
      {
        "type": "item",
        "text": "2 eggs, lightly beaten"
      },
      {
        "type": "item",
        "text": "⅓ Cup(s) vegetable oil"
      },
      {
        "type": "item",
        "text": "3 Tablespoon(s) butter"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Preheat oven to 350. Grease 8-inch square pan."
      },
      {
        "type": "step",
        "text": "Combine flour, sugar, corn meal, baking powder and salt in medium bowl and mix."
      },
      {
        "type": "step",
        "text": "Combine milk, eggs, vegetable oil and butter in small bowl and mix well."
      },
      {
        "type": "step",
        "text": "Add milk mixture to flour mixture and stir until smooth."
      },
      {
        "type": "step",
        "text": "Pour into 8-inch pan."
      },
      {
        "type": "step",
        "text": "Bake for 35 minutes or until inserted knife in center comes out clean."
      }
    ],
    "notes": null,
    "images": [],
