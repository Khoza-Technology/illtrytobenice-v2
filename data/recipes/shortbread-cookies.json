    "id": "shortbread-cookies",
    "slug": "shortbread-cookies",
    "title": "Shortbread Cookies",
    "summary": null,
    "contributor": "genevieve",
    "categories": [
      "dessert"
    ],
    "cuisine": null,
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "¾ C + 1 Tbsp butter"
      },
      {
        "type": "item",
        "text": "⅓ heaping C sugar"
      },
      {
        "type": "item",
        "text": "¼ tsp salt"
      },
      {
        "type": "item",
        "text": "1½ scant C flour"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Preheat oven to 350 and place rack in middle of oven."
      },
      {
        "type": "step",
        "text": "Cream butter, sugar, and salt in a mixing bowl."
      },
      {
        "type": "step",
        "text": "Add flour to combine."
      },
      {
        "type": "step",
        "text": "Place dough into 8x8 glass, ungreased pan and press flat with your fingers."
      },
      {
        "type": "step",
        "text": "Add and smash in whatever chips you prefer."
      },
      {
        "type": "step",
        "text": "Bake for 18-20 minutes until the bottom and edges just start to turn brown. Look at the sides through the glass, not the top."
      },
      {
        "type": "step",
        "text": "Let cool 15 minutes. Cut into bars and place cookies on cooling rack."
      }
    ],
    "notes": null,
    "images": [],
