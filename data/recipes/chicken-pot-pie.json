      },
      "total": {
        "iso": "PT20M",
        "minutes": 20,
        "label": "20 mins"
      }
    },
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "2 Cup(s) Chicken, chopped and cooked"
      },
      {
        "type": "item",
        "text": "10 Ounce(s) Frozen mixed vegetables"
      },
      {
        "type": "item",
        "text": "¼ Cup(s) butter"
      },
      {
        "type": "item",
        "text": "⅓ Cup(s) corn starch"
      },
      {
        "type": "item",
        "text": "½ Teaspoon(s) kosher salt"
      },
      {
        "type": "item",
        "text": "½ Teaspoon(s) ground sage"
      },
      {
        "type": "item",
        "text": "⅛ Teaspoon(s) ground black pepper"
      },
      {
        "type": "item",
        "text": "¾ Cup(s) milk"
      },
      {
        "type": "item",
        "text": "2 Cup(s) chicken broth"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Prepare pie crust."
      },
      {
        "type": "step",
        "text": "Saute vegetables until al dente in butter. Add chicken, corn starch, salt, sage and pepper. While on medium high heat, add chicken broth, stirring constantly until thickened. If you need to add more corn starch, in a separate bowl, mix corn starch with a little water. Then add this mixture to the chicken/vegetable mixture. Add milk. Stir until combined. Pour into individual foil pans."
      },
      {
        "type": "step",
        "text": "Top with pie crust. Cover with foil and freeze."
      },
      {
        "type": "step",
        "text": "To cook: remove from freezer, place pans uncovered on rimmed baking sheet. Cook at 400 for 1 hour."
      }
    ],
    "notes": null,
