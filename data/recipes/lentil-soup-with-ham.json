        "type": "item",
        "text": "2 Tablespoon(s) olive oil"
      },
      {
        "type": "item",
        "text": "2 Cup(s) Dried brown lentils"
      },
      {
        "type": "item",
        "text": "2 carrot, chopped"
      },
      {
        "type": "item",
        "text": "1 onion, diced"
      },
      {
        "type": "item",
        "text": "3 Clove(s) minced garlic"
      },
      {
        "type": "item",
        "text": "½ Cup(s) white wine"
      },
      {
        "type": "item",
        "text": "7 Cup(s) chicken broth"
      },
      {
