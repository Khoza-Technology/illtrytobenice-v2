    "ingredients": [
      {
        "type": "item",
        "text": "6 potatoes, boiled and grated"
      },
      {
        "type": "item",
        "text": "2 Cup(s) sour cream"
      },
      {
        "type": "item",
        "text": "1½ Cup(s) grated cheddar cheese"
      },
      {
        "type": "item",
        "text": "1 Can(s) cream of chicken soup"
      },
      {
        "type": "item",
        "text": "¼ Cup(s) dried onions"
      },
      {
        "type": "item",
        "text": "1 Cup(s) corn flakes, crushed"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Mix all the ingredients together in a medium bowl. Preheat 9x13"
      },
      {
        "type": "step",
        "text": "\""
      },
      {
        "type": "step",
        "text": "pan in 425 degree oven with ⅓ cup butter in it."
      },
      {
        "type": "step",
        "text": "Pour mixture into pan."
      },
      {
        "type": "step",
        "text": "Bake at 425 for 15 to 20 minutes."
      },
      {
        "type": "step",
        "text": "Cut into big slices and top with cheese, or cinnamon and sugar or syrup or jam or yogurt (my favorite)."
      }
    ],
