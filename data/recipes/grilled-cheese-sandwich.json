    "ingredients": [
      {
        "type": "item",
        "text": "1 Tablespoon(s) dijon mustard"
      },
      {
        "type": "item",
        "text": "1 Tablespoon(s) mayonnaise"
      },
      {
        "type": "item",
        "text": "1 tomato"
      },
      {
        "type": "item",
        "text": "1 red onion, thinly sliced"
      },
      {
        "type": "item",
        "text": "2 Slice(s) cheddar cheese"
      },
      {
        "type": "item",
        "text": "2 Slice(s) Provolone cheese"
      },
      {
        "type": "item",
        "text": "2 Slice(s) wheat bread"
      },
      {
        "type": "item",
        "text": "1 Tablespoon(s) butter"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Mix mustard and mayo together. Spread very thinly onto the inside of both pieces of bread."
      },
      {
        "type": "step",
        "text": "Place two slices of tomato on one piece of bread and two slices of mild cheddar on the other slice. On top of the tomatoes place several slices of red onion followed by two slices of provolone."
      },
      {
        "type": "step",
        "text": "Put two halves together. Spread butter on the outside of the bread. Cook sandwich over low heat for at least 5 minutes. Flip and cook another couple minutes."
      }
    ],
