    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "2 cups all-purpose flour"
      },
      {
        "type": "item",
        "text": "1 teaspoon baking soda"
      },
      {
        "type": "item",
        "text": "¼ teaspoon salt"
      },
      {
        "type": "item",
        "text": "½ cup butter"
      },
      {
        "type": "item",
        "text": "¾ cup brown sugar"
      },
      {
        "type": "item",
        "text": "2 eggs, beaten"
      },
      {
        "type": "item",
        "text": "2⅓ cups mashed overripe bananas"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x5 inch loaf pan."
      },
      {
        "type": "step",
        "text": "In a large bowl, combine flour, baking soda and salt. In a separate bowl, cream together butter and brown sugar. Stir in eggs and mashed bananas until well blended. Stir banana mixture into flour mixture; stir just to moisten. Pour batter into prepared loaf pan."
      },
      {
        "type": "step",
        "text": "Bake in preheated oven for 60 to 65 minutes, until a toothpick inserted into center of the loaf comes out clean. Let bread cool in pan for 10 minutes, then turn out onto a wire rack."
      }
    ],
