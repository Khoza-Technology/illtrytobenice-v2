    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "3 Tablespoon(s) butter"
      },
      {
        "type": "item",
        "text": "1 Cup(s) celery, finely chopped"
      },
      {
        "type": "item",
        "text": "½ Cup(s) onion, chopped"
      },
      {
        "type": "item",
        "text": "3 Cup(s) bread crumbs"
      },
      {
        "type": "item",
        "text": "3 Cup(s) crumbled cornbread"
      },
      {
        "type": "item",
        "text": "3 Cup(s) chicken broth"
      },
      {
        "type": "item",
        "text": "2 eggs"
      },
      {
        "type": "item",
        "text": "1 Teaspoon(s) poultry seasoning"
      },
      {
        "type": "item",
        "text": "1 Teaspoon(s) salt"
      },
      {
        "type": "item",
        "text": "½ Teaspoon(s) ground black pepper"
      },
      {
        "type": "item",
        "text": "½ Teaspoon(s) ground sage"
      },
      {
        "type": "item",
        "text": "½ Cup(s) walnuts or pecans"
      },
      {
        "type": "item",
        "text": "1 Recipe Cornbread"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Make cornbread"
      },
      {
        "type": "step",
        "text": "Chop cornbread and bread slices into ½"
      },
      {
        "type": "step",
        "text": "\""
      },
      {
        "type": "step",
        "text": "cubes and bake at 350 until toasted."
      },
      {
        "type": "step",
        "text": "Heat butter in skillet over medium-high heat. Add celery and onion; cook, stirring until tender."
      },
      {
        "type": "step",
        "text": "Add nuts and saute together until nuts are browned."
      },
      {
        "type": "step",
        "text": "Combine celery mixture with bread crumbs and cornbread; mix."
      },
      {
        "type": "step",
        "text": "In a separate bowl, combine broth, eggs"
      },
      {
        "type": "step",
        "text": ", poultry seasoning, salt, pepper and sage and mix together."
      },
      {
        "type": "step",
        "text": "Add broth mixture to bread crumb mix."
      },
      {
        "type": "step",
        "text": "Spoon into a 9x13-inch dish."
      },
      {
        "type": "step",
        "text": "Bake at 350 for 20 minutes or until light brown and crisp around the edges."
      }
    ],
    "notes": null,
