  "schemaVersion": 1,
  "recipe": {
    "id": "veggie-burritos",
    "slug": "veggie-burritos",
    "title": "Veggie Burritos",
    "summary": null,
    "contributor": "amy",
    "categories": [
      "dinner"
    ],
    "cuisine": "American",
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "2 Teaspoon(s) vegetable oil"
      },
      {
        "type": "item",
        "text": "1 red onion, chopped"
      },
      {
        "type": "item",
        "text": "2 Clove(s) garlic, minced"
      },
      {
        "type": "item",
        "text": "1 green pepper, seeded and chopped"
      },
      {
        "type": "item",
        "text": "1 red pepper, seeded and chopped"
      },
      {
        "type": "item",
        "text": "¼ Cup(s) minced fresh cilantro"
      },
      {
        "type": "item",
        "text": "1 Tablespoon(s) chili powder"
      },
      {
        "type": "item",
        "text": "2 Teaspoon(s) ground cumin"
      },
      {
        "type": "item",
        "text": "½ Teaspoon(s) cayenne pepper"
      },
      {
        "type": "item",
        "text": "¼ Cup(s) dry white wine"
      },
      {
        "type": "item",
        "text": "1 Cup(s) corn"
      },
      {
        "type": "item",
        "text": "1 Can(s) tomatoes, drain juice"
      },
      {
        "type": "item",
        "text": "1 Can(s) garbanzo beans, drain juice"
      },
      {
        "type": "item",
        "text": "2 zucchini, chopped"
      },
      {
        "type": "item",
        "text": "2 Cup(s) sugar snap peas"
      },
      {
        "type": "item",
        "text": "1 Cup(s) shredded cheese"
      },
      {
        "type": "item",
        "text": "8 flour tortillas"
      },
      {
        "type": "item",
        "text": "1 Cup(s) sour cream"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Heat oil in a large, deep skillet over medium-high heat. Add onion, garlic, green and red peppers, cilantro, chili powder, cumin and cayenne pepper."
      },
      {
        "type": "step",
        "text": "Reduce heat to medium and saute, stirring constantly until the vegetables are soft."
      },
      {
        "type": "step",
        "text": "Add wine, turn up heat to medium-high, and stir until most of the wine has evaporated, about 3 minutes."
      },
      {
        "type": "step",
        "text": "Add corn, tomatoes and garbanzo beans. Stir constantly until corn has turned deep yellow and tomatoes have thickened, about 7 minutes."
      },
      {
        "type": "step",
        "text": "Add zucchini and peas. Continue stirring just until the vegetables are cooked through, about 5 minutes."
      },
      {
        "type": "step",
        "text": "Serve on tortillas and add sour cream and cheese if desired."
      }
    ],
    "notes": null,
