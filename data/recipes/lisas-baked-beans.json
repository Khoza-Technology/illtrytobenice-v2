    "id": "lisas-baked-beans",
    "slug": "lisas-baked-beans",
    "title": "Lisa's Baked Beans",
    "summary": null,
    "contributor": "amy",
    "categories": [
      "sides"
    ],
    "cuisine": "American",
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "5 Cup(s) water"
      },
      {
        "type": "item",
        "text": "2 Cup(s) dried pinto beans"
      },
      {
        "type": "item",
        "text": "1 onion, chopped"
      },
      {
        "type": "item",
        "text": "¼ Pound(s) salt pork with rind, chopped"
      },
      {
        "type": "item",
        "text": "⅓ Cup(s) brown sugar, packed"
      },
      {
        "type": "item",
        "text": "3 Tablespoon(s) molasses"
      },
      {
        "type": "item",
        "text": "1 Teaspoon(s) salt"
      },
      {
        "type": "item",
        "text": "½ Teaspoon(s) mustard"
      },
      {
        "type": "item",
        "text": "1 Pinch(s) pepper"
      },
      {
        "type": "item",
        "text": "2 Can(s) tomato sauce, 8 oz each"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Soak beans in water overnight."
      },
      {
        "type": "step",
        "text": "Heat soaked beans in same water to boiling. Cover and simmer 1 to 2 hours. Drain, reserving liquid."
      },
      {
        "type": "step",
        "text": "Layer onion, pork and cooked beans in a dutch over."
      },
      {
        "type": "step",
        "text": "Mix brown sugar, molasses, salt, mustard, pepper, and tomato sauce with reserved liquid."
      },
      {
        "type": "step",
        "text": "Pour over beans. Add water to almost cover beans, if"
      },
      {
        "type": "step",
        "text": "necessary. Cover and bake at 350 for 3 hours; stir occasionally. Uncover and bake to desired consistency."
      }
    ],
    "notes": null,
