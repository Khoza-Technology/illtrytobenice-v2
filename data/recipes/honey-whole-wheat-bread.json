    "categories": [
      "bread"
    ],
    "cuisine": "American",
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "3 Tablespoon(s) yeast"
      },
      {
        "type": "item",
        "text": "6 Cup(s) water"
      },
      {
        "type": "item",
        "text": "¾ Cup(s) softened butter"
      },
      {
        "type": "item",
        "text": "⅜ Cup(s) brown sugar"
      },
      {
        "type": "item",
        "text": "¾ Cup(s) honey"
      },
      {
        "type": "item",
        "text": "3 Teaspoon(s) salt"
      },
      {
        "type": "item",
        "text": "9 Cup(s) white flour"
      },
      {
        "type": "item",
        "text": "6 Cup(s) whole wheat flour"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Dissolve yeast in warm water (125 degrees)"
      },
      {
        "type": "step",
        "text": "In large bowl, combine butter, brown sugar, honey and salt. Mix well."
      },
      {
        "type": "step",
        "text": "Add yeast mixture and then gradually add flours"
      },
      {
        "type": "step",
        "text": "Turn onto floured surface and knead until smooth (10 minutes)"
      },
      {
        "type": "step",
        "text": "Place in buttered bowl, and let rise until double"
      },
      {
        "type": "step",
        "text": "Punch down and let rest for a few minutes."
      },
      {
        "type": "step",
        "text": "Divid"
      },
      {
        "type": "step",
        "text": "e dough into 6 parts and shape into loaves"
      },
      {
        "type": "step",
        "text": "Place in greased pans and let rise for an hour."
      },
      {
        "type": "step",
        "text": "Bake at 375 degrees for 35-40 minutes."
      }
    ],
