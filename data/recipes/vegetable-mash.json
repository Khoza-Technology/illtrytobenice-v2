  "schemaVersion": 1,
  "recipe": {
    "id": "vegetable-mash",
    "slug": "vegetable-mash",
    "title": "Vegetable Mash",
    "summary": null,
    "contributor": "amy",
    "categories": [
      "sides"
    ],
    "cuisine": "American",
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "3 Pound(s) potatoes, cubed"
      },
      {
        "type": "item",
        "text": "1 Pound(s) carrots-skin peeled and chopped into big 3 inch chunks"
      },
      {
        "type": "item",
        "text": "1 Pound(s) parsnips-peeled, cut into 1-inch pieces"
      },
      {
        "type": "item",
        "text": "1 Cup(s) whole milk"
      },
      {
        "type": "item",
        "text": "½ Cup(s) butter"
      },
      {
        "type": "item",
        "text": "1¼ Cup(s) grated cheddar cheese"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Place potatoes in a saucepan, cover with 2 inches of water and add 2½ teaspoon salt."
      },
      {
        "type": "step",
        "text": "Combine carrots and parsnips in another pan; cover with 2 inches of water, and add 1½ teaspoons salt."
      },
      {
        "type": "step",
        "text": "Bring vegetables to a boil, reduce heat and simmer until fork-tender."
      },
      {
        "type": "step",
        "text": "Drain vegetables."
      },
      {
        "type": "step",
        "text": "Heat milk and butter until butter is melted."
      },
      {
        "type": "step",
        "text": "Mash vegetables together; stir in milk mixture."
      },
      {
        "type": "step",
        "text": "Season with salt and pepper. Let cool completely."
      },
      {
        "type": "step",
        "text": "Refrigerate up to 5 days."
      },
      {
        "type": "step",
        "text": "Preheat oven to 375. Spoon beef stew into baking dish(es). Cover with vegetable mash; sprinkle cheese on top."
      },
      {
        "type": "step",
        "text": "Bake 50 minutes."
      },
      {
        "type": "step",
        "text": "Let cool 15 minutes before serving."
      }
    ],
    "notes": null,
