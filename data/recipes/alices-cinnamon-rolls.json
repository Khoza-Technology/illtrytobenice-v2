  "schemaVersion": 1,
  "recipe": {
    "id": "alices-cinnamon-rolls",
    "slug": "alices-cinnamon-rolls",
    "title": "Alice's Cinnamon Rolls",
    "summary": null,
    "contributor": "genevieve",
    "categories": [
      "breakfast"
    ],
    "cuisine": null,
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "2 Tablespoon(s) active dry yeast active dry yeast"
      },
      {
        "type": "item",
        "text": "½ Cup(s) water"
      },
      {
        "type": "item",
        "text": "2 Cup(s) milk, scalded"
      },
      {
        "type": "item",
        "text": "½ Cup(s) sugar"
      },
      {
        "type": "item",
        "text": "½ Cup(s) shortening"
      },
      {
        "type": "item",
        "text": "2 Teaspoon(s) salt"
      },
      {
        "type": "item",
        "text": "6 Cup(s) flour"
      },
      {
        "type": "item",
        "text": "2 egg"
      },
      {
        "type": "item",
        "text": "4 Tablespoon(s) butter, melted"
      },
      {
        "type": "item",
        "text": "1 Cup(s) brown sugar"
      },
      {
        "type": "item",
        "text": "4 Teaspoon(s) cinnamon"
      },
      {
        "type": "item",
        "text": "1 Cup(s) powdered sugar"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Combine yeast and warm water in a small bowl."
      },
      {
        "type": "step",
        "text": "In another large bowl, combine milk, sugar, shortening, and salt. Slowly add 3 cups flour. Beat lightly."
      },
      {
        "type": "step",
        "text": "Beat in yeast mixture and egg."
      },
      {
        "type": "step",
        "text": "Slowly add flour kneading lightly. Too much kneading will make dough tough. Dough should be very sticky and wet."
      },
      {
        "type": "step",
        "text": "Let rise in greased bowl until doubled."
      },
      {
        "type": "step",
        "text": "Divide in half. Roll out each dough ball into a large rectangle and cover with butter. Sprinkle generously with brown sugar and cinnamon."
      },
      {
        "type": "step",
        "text": "Roll and fold ends under. Cut in ½ inch slices and place on rimmed baking sheet."
      },
      {
        "type": "step",
        "text": "Cover and let rise for 1 hour."
      },
      {
        "type": "step",
        "text": "Preheat oven to 400 and bake for 15 minutes."
      },
      {
        "type": "step",
        "text": "Can freeze in foil. Reheat at 300 for 20-25 minutes."
      },
      {
        "type": "step",
        "text": "Mix confectioner's sugar and water in a small bowl until the sauce is the consistency you like. Spread on rolls."
      }
    ],
    "notes": null,
