    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "½ Teaspoon(s) dijon mustard"
      },
      {
        "type": "item",
        "text": "4 7-inch pita rounds, halved crosswise"
      },
      {
        "type": "item",
        "text": "2 Cup(s) shredded romaine lettuce"
      },
      {
        "type": "item",
        "text": "1 Pinch(s) pepper to taste"
      },
      {
        "type": "item",
        "text": "1 Pinch(s) salt to taste"
      },
      {
        "type": "item",
        "text": "½ Cup(s) blue cheese, crumbled"
      },
      {
        "type": "item",
        "text": "4 bacon, cooked crisp and crumbled"
      },
      {
        "type": "item",
        "text": "1 medium tomato, chopped"
      },
      {
        "type": "item",
        "text": "2½ Cup(s) diced cooked chicken"
      },
      {
        "type": "item",
        "text": "1 avocado, peeled and chopped"
      },
      {
        "type": "item",
        "text": "3 Tablespoon(s) olive oil"
      },
      {
        "type": "item",
        "text": "1 Tablespoon(s) red wine vinegar"
      },
      {
        "type": "item",
        "text": "1 hard-boiled egg, minced"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "In blender, puree together mustard, vinegar, olive oil, salt and pepper to taste until emulsified. Pour into bowl. Add avocado, chicken, tomato, bacon, cheese, egg and toss lightly."
      },
      {
        "type": "step",
        "text": "Divide romaine among pita halves. Spoon chicken mixture into pita halves."
      }
    ],
