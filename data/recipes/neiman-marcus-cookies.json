  "recipe": {
    "id": "neiman-marcus-cookies",
    "slug": "neiman-marcus-cookies",
    "title": "Neiman-Marcus Cookies",
    "summary": null,
    "contributor": "amy",
    "categories": [
      "dessert"
    ],
    "cuisine": "American",
    "times": {},
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "1 Cup(s) butter"
      },
      {
        "type": "item",
        "text": "1 Cup(s) sugar"
      },
      {
        "type": "item",
        "text": "1 Cup(s) brown sugar"
      },
      {
        "type": "item",
        "text": "2 eggs"
      },
      {
        "type": "item",
        "text": "1 Teaspoon(s) vanilla"
      },
      {
        "type": "item",
        "text": "2½ Cup(s) oatmeal"
      },
      {
        "type": "item",
        "text": "2 Cup(s) flour"
      },
      {
        "type": "item",
        "text": "1 Teaspoon(s) baking soda"
      },
      {
        "type": "item",
        "text": "1 Teaspoon(s) baking powder"
      },
      {
        "type": "item",
        "text": "½ Teaspoon(s) salt"
      },
      {
        "type": "item",
        "text": "12 Ounce(s) chocolate chips"
      },
      {
        "type": "item",
        "text": "4 Ounce(s) hershey bar, grated"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Blend oatmeal in a blender to a fine powder."
      },
      {
        "type": "step",
        "text": "Combine oatmeal, flour, salt, baking powder and soda and set aside."
      },
      {
        "type": "step",
        "text": "Cream butter and sugars"
      },
      {
        "type": "step",
        "text": "Add eggs and vanilla"
      },
      {
        "type": "step",
        "text": "Add flour mixture to butter mixture and mix"
      },
      {
        "type": "step",
        "text": "Add grated Hershey bar and chocolate chips."
      },
      {
        "type": "step",
        "text": "Bake for 10 minutes at 375."
      },
      {
        "type": "step",
        "text": "Note: Extra batter can be frozen in ice cube trays and then put into freezer bags. When you want fresh cookies, take out a cube and bake for 10 minutes at 375."
      }
    ],
