    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "3 cups white sugar"
      },
      {
        "type": "item",
        "text": "3/4 cup margarine"
      },
      {
        "type": "item",
        "text": "2/3 cup evaporated milk"
      },
      {
        "type": "item",
        "text": "1 (12 ounce) package semisweet chocolate chips"
      },
      {
        "type": "item",
        "text": "1 (7 ounce) jar marshmallow creme"
      },
      {
        "type": "item",
        "text": "1 cup chopped walnuts"
      },
      {
        "type": "item",
        "text": "1 teaspoon vanilla extract"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "Grease a 9x13-inch pan."
      },
      {
        "type": "step",
        "text": "Mix sugar, margarine, and evaporated milk in a large, heavy saucepan over medium heat, stirring to dissolve sugar. Bring mixture to a full boil for 5 minutes, stirring constantly."
      },
      {
        "type": "step",
        "text": "Remove from heat and stir in chocolate chips until melted and thoroughly combined. Beat in marshmallow creme, walnuts, and vanilla extract. Transfer fudge to the prepared pan and let cool before cutting into squares."
      }
    ],
