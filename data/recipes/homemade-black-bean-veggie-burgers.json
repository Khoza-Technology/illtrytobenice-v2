      },
      "total": {
        "iso": "PT35M",
        "minutes": 35,
        "label": "35 mins"
      }
    },
    "servings": null,
    "ingredients": [
      {
        "type": "item",
        "text": "1 (16 ounce) can black beans, drained and rinsed"
      },
      {
        "type": "item",
        "text": "½ green bell pepper, cut into 2 inch pieces"
      },
      {
        "type": "item",
        "text": "½ onion, cut into wedges"
      },
      {
        "type": "item",
        "text": "3 cloves garlic, peeled"
      },
      {
        "type": "item",
        "text": "1 egg"
      },
      {
        "type": "item",
        "text": "1 tablespoon chili powder"
      },
      {
        "type": "item",
        "text": "1 tablespoon cumin"
      },
      {
        "type": "item",
        "text": "1 teaspoon Thai chili sauce or hot sauce"
      },
      {
        "type": "item",
        "text": "½ cup bread crumbs"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "If grilling, preheat an outdoor grill for high heat, and lightly oil a sheet of aluminum foil. If baking, preheat oven to 375 degrees F (190 degrees C), and lightly oil a baking sheet."
      },
      {
        "type": "step",
        "text": "In a medium bowl, mash black beans with a fork until thick and pasty."
      },
      {
        "type": "step",
        "text": "In a food processor, finely chop bell pepper, onion, and garlic. Then stir into mashed beans."
      },
      {
        "type": "step",
        "text": "In a small bowl, stir together egg, chili powder, cumin, and chili sauce."
      },
      {
        "type": "step",
        "text": "Stir the egg mixture into the mashed beans. Mix in bread crumbs until the mixture is sticky and holds together. Divide mixture into four patties."
      },
      {
        "type": "step",
        "text": "If grilling, place patties on foil, and grill about 8 minutes on each side. If baking, place patties on baking sheet, and bake about 10 minutes on each side."
      }
    ],
    "notes": null,
