    "servings": {
      "label": "6",
      "count": 6
    },
    "ingredients": [
      {
        "type": "item",
        "text": "1 cup mayonnaise"
      },
      {
        "type": "item",
        "text": "1 (16 ounce) container sour cream"
      },
      {
        "type": "item",
        "text": "1 (1.8 ounce) package dry leek soup mix"
      },
      {
        "type": "item",
        "text": "1 (4 ounce) can water chestnuts, drained and chopped"
      },
      {
        "type": "item",
        "text": "½ (10 ounce) package frozen chopped spinach, thawed and drained"
      },
      {
        "type": "item",
        "text": "1 (1 pound) loaf round sourdough bread"
      }
    ],
    "instructions": [
      {
        "type": "step",
        "text": "In a medium bowl, mix together mayonnaise, sour cream, dry leek soup mix, water chestnuts and chopped spinach. Chill in the refrigerator 6 hours, or overnight."
      },
      {
        "type": "step",
        "text": "Remove top and interior of sourdough bread. Fill with mayonnaise mixture. Tear removed bread chunks into pieces for dipping."
      }
    ],
    "notes": null,
